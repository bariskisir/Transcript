{
  "name": "transcript",
  "version": "3.12.1",
  "description": "Secure real-time desktop transcription",
  "main": "./out/main/index.js",
  "author": "bariskisir",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "npm run typecheck && vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "biome lint src tests vite.config.mts vitest.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never && electron-builder --win nsis --arm64 --publish never",
    "package:win:x64": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:win:arm64": "npm run build && electron-builder --win nsis --arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never && electron-builder --linux --arm64 --publish never",
    "package:linux:x64": "npm run build && electron-builder --linux --x64 --publish never",
    "package:linux:arm64": "npm run build && electron-builder --linux --arm64 --publish never",
    "release": "npm run package:win && npm run package:linux"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "bing-translate-api": "4.3.0",
    "electron-log": "5.4.4",
    "transcribe-cpp": "0.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@reduxjs/toolkit": "2.13.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "antd": "6.6.6",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "i18next": "26.4.7",
    "jsdom": "30.1.3",
    "lucide-react": "1.58.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.19",
    "react-redux": "9.3.0",
    "sass": "1.105.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-electron": "1.1.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "com.bariskisir.transcript",
    "productName": "Transcript",
    "asar": true,
    "asarUnpack": [
      "node_modules/@transcribe-cpp/**",
      "node_modules/koffi/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray-icon-bluetooth.png",
        "to": "tray-icon-bluetooth.png"
      },
      {
        "from": "build/tray-icon-weather.png",
        "to": "tray-icon-weather.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "transcript-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Transcript"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "Transcript-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Transcript needs microphone access to convert speech into text."
      }
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "Transcript-${version}-linux-${arch}.${ext}"
    }
  }
}
